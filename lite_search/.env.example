# ---- data source: pick ONE ----
CATALOG_CSV=data/demo_products.csv
# DATABASE_URL=postgresql://user:pass@db-host:5432/shop
# SQL_QUERY=SELECT product_id, name, cat, brand, colour, price, description FROM products WHERE active = 1
# COLUMN_MAP=product_id:id,name:title,cat:category,colour:color

# ---- cache ----
REDIS_URL=redis://localhost:6379/0
CACHE_PREFIX=ls
TTL_RESULT=600

# ---- embeddings ----
EMBEDDER=sentence-transformers      # or "hashing" (no model download; testing only)
EMB_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
INDEX_DIR=.lite_search_index

# ---- optional LLM fallback (only called when rules find nothing) ----
LLM_PROVIDER=none                   # or "anthropic"
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-5-5

# ---- server ----
# SEARCH_API_KEY=change-me          # clients send header X-API-Key
# WARM_FILE=data/common_queries.txt
# CORS_ORIGINS=https://shop.example.com    # only if a browser calls the API directly
# RELOAD_MINUTES=30                        # auto re-sync with the product DB
